# Neon Postgres — used by Prisma (see prisma/schema.prisma)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk authentication (added once Phase 1 terminal setup runs `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary — used for store logo and product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of emails allowed admin access (see app/admin layout)
ADMIN_EMAILS=

# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL='$'
